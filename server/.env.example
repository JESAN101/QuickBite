PORT=5000

MONGO_URI=

JWT_SECRET=

NODE_ENV=development

# Frontend origin allowed by CORS (e.g. http://localhost:5173)
CLIENT_URL=http://localhost:5173

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =============================================
# Order cancellation window (in minutes)
# Customers can cancel their own order within
# this time after placing it.
# =============================================
ORDER_CANCELLATION_WINDOW_MINUTES=5

# =============================================
# Email — Brevo (Sendinblue) HTTP API
# Transactional email is sent via:
#   POST https://api.brevo.com/v3/smtp/email
# Emails are skipped when BREVO_API_KEY is
# not set (useful for local development).
# =============================================
BREVO_API_KEY=
BREVO_SENDER_NAME=QuickBite
BREVO_SENDER_EMAIL=no-reply@quickbite.app
